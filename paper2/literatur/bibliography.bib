}

@article{silhan2026,
	title = {Monitoring formative impact of multiple quiz types on exam performance: introductory accounting in online environment.},
	issn = {0963-9284},
	url = {https://research.ebsco.com/linkprocessor/plink?id=de227e21-ff44-3aa0-8bb2-6d452a4ee324},
	doi = {10.1080/09639284.2026.2620760},
	abstract = {This study analyzes the formative impact of multiple quiz types on conceptual exams. In an online introductory accounting course designed for non-business majors, two types of e-quizzes were assigned in tandem for each lesson: a multiple-choice conceptual quiz (CQ) and a fill-in numerical quiz (NQ). In effect, these e-quizzes were unproctored, open-book formative assessments administered as graded web-based homework, while the e-exams were closed-book summative assessments with online proctoring. To gauge the formative effects of each quiz type on exam performance, regression analysis was used on a large dataset {\textless}italic{\textgreater}(n{\textless}/italic{\textgreater} = 3,392 students) spanning six academic years (AY2015-16 to AY2020-21). Control variables were included for bonus points, math background, years of college, and seasonality. Main results indicated a positive coefficient for NQ performance, but a nonsignificant coefficient for CQ performance. Subsample results and alternative estimation methods corroborated this finding. Quantile regression analysis further revealed that the NQ coefficient was most positive in the lower quantiles of exam performance. Together, these results suggest that NQs can contribute to conceptual knowledge in addition to procedural knowledge.},
	language = {eng},
	journal = {Accounting Education},
	publisher = {Taylor \& Francis Ltd},
	author = {Silhan, Peter A.},
	month = feb,
	year = {2026},
	keywords = {Other Accounting Services, Accounting, Regression analysis, Online education, Educational tests \& measurements, Test scoring, Formative evaluation, Multiple choice examinations},
	pages = {1--28},
	annote = {Academic Journal},
	annote = {Article},
}

@article{tan2015a,
	title = {Academic {Performance} in {Introductory} {Accounting}: {Do} {Learning} {Styles} {Matter}?},
	volume = {24},
	issn = {0963-9284},
	url = {https://research.ebsco.com/linkprocessor/plink?id=e07ced04-8b89-3638-8c42-25f7faccd5b0},
	doi = {10.1080/09639284.2015.1075315},
	abstract = {This study examines the impact of learning styles on academic performance using major assessment methods (examinations and assignments including multiple-choice and constructed response questions (CRQs)) in an introductory accounting course. Students' learning styles were assessed using Kolb's Learning Style Inventory Version 3.1. The results indicate that students' learning styles, after controlling for other variables, are associated with academic performance, particularly, in the final examination including both formats, multiple-choice questions and CRQs. Students who exhibit the ‘assimilating’ learning style appear to perform better in some of the assessments than students with ‘diverging’ or ‘accommodating’ learning styles. The findings have implications for designing assessments to ensure that they are not biased towards particular learning styles which would improve their validity and fairness.},
	language = {eng},
