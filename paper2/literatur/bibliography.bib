	pages = {33--49},
	annote = {Academic Journal},
	annote = {Article},
}

@article{milliron2008,
	title = {Exploring {Millennial} {Student} {Values} and {Societal} {Trends}: {Accounting} {Course} {Selection} {Preferences}.},
