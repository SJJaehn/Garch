	keywords = {Academic achievement, Accounting education, Other Accounting Services, Educational outcomes, Educational games, Mobile learning},
	pages = {222--247},
	annote = {Academic Journal},
	annote = {Article},
}

@article{delange2003,
	title = {Integrating a virtual learning environment into an introductory accounting course: determinants of student motivation.},
