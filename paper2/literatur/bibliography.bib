@article{rasmussen2024,
	title = {Accounting in action – {The} use of podcasts in principles-level accounting courses.},
	volume = {33},
	issn = {0963-9284},
	url = {https://research.ebsco.com/linkprocessor/plink?id=2e464867-e06d-346a-8167-464ed85e254c},
	doi = {10.1080/09639284.2023.2228286},
	abstract = {This study examines podcasts as a pedagogical approach to improve principles-level accounting students' perceptions of course engagement and the relevance of accounting. In each podcast, the course instructor interviews a business professional who describes how he/she uses accounting information in the workplace. Students listen to podcasts periodically throughout the course. Survey results indicate that approximately one-half of study participants perceived the podcasts increased their engagement in the course and two-thirds perceived the podcasts helped them better understand the relevance of accounting for business professionals. Results are significantly stronger for accounting majors and participants expecting to earn higher course grades. Results for non-accounting majors and participants with lower grade expectations remain positive. These findings suggest that podcasts may be used to positively influence perceptions of course engagement and the relevance of accounting, particularly among accounting majors and high performing students.},
	language = {eng},
	number = {4},
