	pages = {71--83},
	annote = {Academic Journal},
	annote = {Article},
}

@article{seay1994,
	title = {Interactive {Television} {Instruction}: {An} {Assessment} of {Student} {Performance} and {Attitudes} in an {Upper} {Division} {Accounting} {Course}.},
